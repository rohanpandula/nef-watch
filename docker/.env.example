# Private Nikon SDK root mounted read-only into the one-shot initializer. It is
# validated and staged into nef-watch-state, never into Git or the image and
# never mounted into the long-running watcher.
NIKON_SDK_DIR=/mnt/user/Media/.nef-watch-build/nikon-sdk

# Host folders mounted into the watcher container.
NEF_INPUT=/mnt/user/Photos/NEF
NEF_OUTPUT=/mnt/user/Media/Photos/Nikon-TIFF

# Disposable render buffers. Set this to a dedicated capacity-bounded
# filesystem/dataset on your fastest NVMe pool (never /mnt/user). Its statvfs
# total must be no larger than TEMP_CAPACITY_BYTES; an ordinary directory on a
# larger pool intentionally fails startup. Use the canonical direct mount path,
# with no symlink component; temp and ACCEPTANCE_REPORT must remain on this same
# mounted scratch filesystem.
NEF_TEMP_DIR=/mnt/fastest-nvme/nef-watch-scratch/production
TEMP_CAPACITY_BYTES=17179869184
TEMP_MIN_FREE_BYTES=8589934592

# Required for Compose: locally build and pass the private six-file acceptance
# gate, then paste the exact config ID from `docker image inspect`. Mutable tags
# and unknown IDs are rejected; Compose never pulls this value.
IMAGE=sha256:REPLACE_WITH_64_HEX_LOCAL_IMAGE_ID
# Exact root-owned mode-0444 report published by the private gate for IMAGE.
# Keep it under the root-only trust directory on the capacity-bounded NVMe.
ACCEPTANCE_REPORT=/mnt/fastest-nvme/nef-watch-scratch/.trust/acceptance-reports/REPLACE_WITH_64_HEX_LOCAL_IMAGE_ID.acceptance.json
# Linux/Wine is deliberately single-job: parallel X clients would share the
# container's local X socket namespace and weaken per-render isolation.
JOBS=1
INTERVAL=3
MEMORY_LIMIT=4g
CPU_LIMIT=4
PIDS_LIMIT=256
# Total per-render budget; the SDK arena below is included in this number.
RENDER_MEMORY_MIB=1536
SDK_MEMORY_MIB=512
# The container hard RLIMIT_FSIZE is 2048 MiB; accepted values are 768-2048.
RENDER_FILE_SIZE_MIB=2048
MAX_SCAN_ENTRIES=100000
# Set only when importing an older .nef-watch-skip-existing-seeded marker whose
# absolute paths used a different input root (for example /old/photos/NEF).
LEGACY_INPUT_ROOT=
RENDER_TIMEOUT_SECONDS=300
EXIF_TIMEOUT_SECONDS=60
DNG_TIMEOUT_SECONDS=300
TOOL_KILL_GRACE_SECONDS=5
SETTLE_SECONDS=5
# Production interval is 0.1-840 seconds. Health age is 60-900 seconds and must
# be at least 60 seconds greater than INTERVAL.
HEALTH_MAX_AGE_SECONDS=120
STOP_GRACE_PERIOD=7m
INIT_LOCK_TIMEOUT_SECONDS=30
SDK_BOOTSTRAP_TIMEOUT_SECONDS=300
WINEBOOT_TIMEOUT_SECONDS=120
VC_REDIST_TIMEOUT_SECONDS=180
WINESERVER_TIMEOUT_SECONDS=60
STARTUP_KILL_GRACE_SECONDS=10
