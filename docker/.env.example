# Private Nikon SDK copy on the Unraid host. Never commit or publish it.
NIKON_SDK_DIR=/mnt/user/Media/.nef-watch-build/nikon-sdk

# Host folders mounted into the watcher container.
NEF_INPUT=/mnt/user/Photos/NEF
NEF_OUTPUT=/mnt/user/Media/Photos/Nikon-TIFF

IMAGE=nef-watch:nikon-linux
PUID=99
PGID=100
JOBS=4
INTERVAL=3
MEMORY_LIMIT=4g
CPU_LIMIT=4
PIDS_LIMIT=256
# Direct Compose builds cannot calculate this canonical digest; prefer
# docker/build-image.sh. The validated v1.46.0 value is shown for inspection.
SDK_FINGERPRINT=0e8aba70b296966c03c407c8dd77ddee5c073924b9fb38f988881c366a1fbc51
# Direct `docker compose build` cannot calculate the canonical source digest;
# prefer docker/build-image.sh. Set this only from that script's printed value.
SOURCE_FINGERPRINT=compose-direct-unverified
