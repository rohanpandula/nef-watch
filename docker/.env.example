# Private Nikon SDK root mounted read-only at runtime. It is validated and
# staged into the private nef-watch-state volume on first start, never into Git or
# the public image.
NIKON_SDK_DIR=/mnt/user/Media/.nef-watch-build/nikon-sdk

# Host folders mounted into the watcher container.
NEF_INPUT=/mnt/user/Photos/NEF
NEF_OUTPUT=/mnt/user/Media/Photos/Nikon-TIFF

IMAGE=ghcr.io/rohanpandula/nef-watch:linux-amd64
JOBS=4
INTERVAL=3
MEMORY_LIMIT=4g
CPU_LIMIT=4
PIDS_LIMIT=256
